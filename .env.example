# Outage Tracker environment.
#
# Copy to .env.local and fill in what you need. Every setting here is OPTIONAL:
# with an empty file the app runs against a seeded in-memory store and a
# no-token basemap, which is enough to develop and demo the whole product.
#
#   cp .env.example .env.local

# ---------------------------------------------------------------------------
# Database (optional) — switches the app from demo data to real, durable data.
#
# Create a project at https://supabase.com, enable the PostGIS extension, then
# run prisma/migrations/001_initial_schema.sql and 002_search_and_fixes.sql in
# the SQL editor, in that order. See SETUP.md.
#
# Setting these two also enables real accounts via Supabase Auth. Without them
# every visitor is a guest identified by a cookie, and can still report,
# confirm and comment.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses Row Level Security — never expose it to the browser and
# never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Push notifications (optional).
#
# Generate a key pair with:  npx web-push generate-vapid-keys
# Without these, the alerts section of Settings explains that push is
# unavailable instead of offering a switch that cannot work.
# ---------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerts@example.com

# ---------------------------------------------------------------------------
# Rate limiting (optional, recommended in production).
#
# Client addresses are hashed before being used as rate-limit bucket keys and
# are never stored in the clear. A private salt stops those hashes from being
# guessable for a known address.
# ---------------------------------------------------------------------------
RATE_LIMIT_SALT=

# ---------------------------------------------------------------------------
# Basemap (optional).
#
# Defaults to OpenFreeMap, which needs no account and has no request quota.
# Any MapLibre-compatible style URL works here — including a Mapbox style, if
# you would rather use one.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_MAP_STYLE_URL=
NEXT_PUBLIC_MAP_STYLE_URL_DARK=

# ---------------------------------------------------------------------------
# Geocoding (optional).
#
# Defaults to the public Nominatim instance. Its usage policy caps request
# rates and asks for an identifying User-Agent, so point this at a self-hosted
# instance or a commercial geocoder before you carry real traffic.
# ---------------------------------------------------------------------------
NOMINATIM_BASE_URL=
GEOCODER_USER_AGENT=
# Comma-separated ISO country codes to restrict search results. Default: us
GEOCODER_COUNTRY_CODES=
